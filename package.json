{
  "name": "instance-deployer-subgraph",
  "license": "UNLICENSED",
  "scripts": {
    "codegen": "graph codegen",
    "build": "graph build",
    "prepare:base": "mustache config/base.json subgraph.template.yaml > subgraph.yaml",
    "deploy:base": "goldsky subgraph deploy solidity-labs/instance-deployer-base",
    "create-local": "graph create --node http://localhost:8020/ solidity-labs/instance-deployer",
    "remove-local": "graph remove --node http://localhost:8020/ solidity-labs/instance-deployer",
    "deploy-local": "graph deploy --node http://localhost:8020/ --ipfs http://localhost:5001 solidity-labs/instance-deployer"
  },
  "dependencies": {
    "@graphprotocol/graph-cli": "0.51.0",
    "@graphprotocol/graph-ts": "0.31.0"
  },
  "devDependencies": {
    "mustache": "^4.0.1"
  }
}
